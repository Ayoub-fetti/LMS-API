FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (including dev for build)
RUN npm ci

# Copy source code
COPY . .

# Build the NestJS app
RUN npm run build

# Remove dev dependencies after build (optional but cleaner)
RUN npm prune --production

# Expose port (choose ONE port everywhere, example: 8000)
EXPOSE 8000

# Start production server
CMD ["node", "dist/main"]